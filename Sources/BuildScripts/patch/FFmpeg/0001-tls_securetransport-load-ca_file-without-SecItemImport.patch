+#if !HAVE_SECITEMIMPORT
+/**
+ * SecItemImport() is not available on iOS and tvOS, so parse the PEM
+ * CERTIFICATE blocks of a CA file by hand. Other block types are skipped.
+ */
+static int import_ca_pem(URLContext *h, char *path, CFArrayRef *array)
+{
+    static const char begin_tag[] = "-----BEGIN CERTIFICATE-----";
+    static const char end_tag[]   = "-----END CERTIFICATE-----";
+    AVIOContext *s = NULL;
+    CFMutableArrayRef certs = NULL;
+    uint8_t *der = NULL;
+    char *buf = NULL, *b64 = NULL, *p;
+    int64_t size;
+    int ret = 0;
+
+    /* a CA path is always a local file, whatever the stream's whitelist */
+    if ((ret = ffio_open_whitelist(&s, path, AVIO_FLAG_READ,
+                                   &h->interrupt_callback, NULL,
+                                   "file", h->protocol_blacklist)) < 0)
+        goto end;
+
+    if ((size = avio_size(s)) < 0) {
+        ret = size;
+        goto end;
+    }
+
+    if (size == 0 || size >= INT_MAX / 2) {
+        ret = AVERROR_INVALIDDATA;
+        goto end;
+    }
+
+    if (!(buf = av_malloc(size + 1)) || !(b64 = av_malloc(size + 1)) ||
+        !(der = av_malloc(AV_BASE64_DECODE_SIZE(size)))) {
+        ret = AVERROR(ENOMEM);
+        goto end;
+    }
+
+    if ((ret = avio_read(s, buf, size)) < 0)
+        goto end;
+    buf[ret] = '\0';
+
+    if (!(certs = CFArrayCreateMutable(kCFAllocatorDefault, 0,
+                                       &kCFTypeArrayCallBacks))) {
+        ret = AVERROR(ENOMEM);
+        goto end;
+    }
+
+    for (p = buf; (p = strstr(p, begin_tag)); ) {
+        char *body = p + sizeof(begin_tag) - 1;
+        char *end  = strstr(body, end_tag);
+        int len = 0, der_size;
+        CFDataRef data;
+        SecCertificateRef cert;
+
+        if (!end) {
+            ret = AVERROR_INVALIDDATA;
+            goto end;
+        }
+
+        /* base64 decoding stops at whitespace, so strip it first */
+        for (; body < end; body++) {
+            if (!av_isspace(*body))
+                b64[len++] = *body;
+        }
+        b64[len] = '\0';
+
+        if ((der_size = av_base64_decode(der, b64, AV_BASE64_DECODE_SIZE(len))) <= 0) {
+            ret = AVERROR_INVALIDDATA;
+            goto end;
+        }
+
+        data = CFDataCreate(kCFAllocatorDefault, der, der_size);
+        if (!data) {
+            ret = AVERROR(ENOMEM);
+            goto end;
+        }
+        cert = SecCertificateCreateWithData(kCFAllocatorDefault, data);
+        CFRelease(data);
+        if (!cert) {
+            ret = AVERROR_INVALIDDATA;
+            goto end;
+        }
+        CFArrayAppendValue(certs, cert);
+        CFRelease(cert);
+
+        p = end + sizeof(end_tag) - 1;
+    }
+
+    if (CFArrayGetCount(certs) == 0) {
+        ret = AVERROR_INVALIDDATA;
+        goto end;
+    }
+
+    *array = CFRetain(certs);
+    ret = 0;
+
+end:
+    av_free(buf);
+    av_free(b64);
+    av_free(der);
+    if (certs)
+        CFRelease(certs);
+    if (s)
+        avio_close(s);
+    return ret;
+}
+#endif
